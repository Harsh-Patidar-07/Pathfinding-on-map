{
  "name": "pathfinding-world-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance web-based geographic pathfinding visualizer",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm run build:wasm && pnpm --filter @pathfinder/connector build && pnpm --filter @pathfinder/visualizer build && pnpm --filter web build",
    "test": "pnpm run test:crates && pnpm --filter @pathfinder/connector test && pnpm --filter @pathfinder/visualizer test",
    "test:crates": "cargo test --manifest-path crates/pathfinder-wasm/Cargo.toml",
    "test:connector": "pnpm --filter @pathfinder/connector test",
    "test:visualizer": "pnpm --filter @pathfinder/visualizer test",
    "build:wasm": "wasm-pack build crates/pathfinder-wasm --target web --out-dir ../../packages/connector/wasm",
    "build:crates": "cargo build --manifest-path crates/pathfinder-wasm/Cargo.toml --target wasm32-unknown-unknown --release",
    "build:web": "pnpm --filter web build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@12.11.2"
}
