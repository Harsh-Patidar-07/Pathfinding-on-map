{
  "name": "@pathfinder/connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript Web Worker bridge for Pathfinder Wasm memory",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    },
    "./wasm": {
      "import": "./wasm/pathfinder_wasm.js",
      "types": "./wasm/pathfinder_wasm.d.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx tests/connector.test.ts"
  }
}
